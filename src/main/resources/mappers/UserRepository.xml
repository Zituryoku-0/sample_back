<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.sample_back.repository.login.UserRepository">

    <select id="selectUser" resultType="com.example.sample_back.repository.login.UserRecord">
        SELECT
        userId,
        userName
        FROM userinfo
        WHERE userId = #{userId}
        AND userPassword = #{password}
    </select>

</mapper>

<mapper namespace="com.example.sample_back.repository.registUser.RegistUser">

    <insert id="registUser">
        INSERT INTO
        userInfo (userId, userName, userPassword)
        VALUES(#{userId}, #{userName}, "{password})
    </insert>
</mapper>
